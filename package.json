{
  "name": "sparky-ai",
  "productName": "Sparky AI",
  "version": "0.2.0",
  "description": "Yüzen prompt asistanı — girdiğiniz metni yerel (Ollama / LM Studio) veya bulut modelleriyle profesyonel bir prompt'a dönüştürür.",
  "main": "src/main/main.js",
  "author": "Sparky AI",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis portable",
    "pack": "electron-builder --dir",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sparkyai.app",
    "productName": "Sparky AI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sparky AI"
    }
  }
}
